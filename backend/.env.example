# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Main database (your development data)
DATABASE_URL=postgresql+psycopg2://mmm_user:CHANGE_ME@localhost:5432/mmm

# Separate database used ONLY by pytest. The name must end with "_test".
TEST_DATABASE_URL=postgresql+psycopg2://mmm_user:CHANGE_ME@localhost:5432/mmm_test

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. The app will not start without it.
JWT_SECRET=

JWT_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# Password given to the three demo users created by seed.py (8-64 chars, letter + digit)
SEED_DEMO_PASSWORD=

# Google single sign-on: the OAuth "Web application" client ID from Google Cloud Console.
# Use GOOGLE_CLIENT_ID for one value, or GOOGLE_CLIENT_IDS for several separated by commas.
# These are public identifiers, not secrets, but keep them in the environment (and Render), not in code.
# Leave both empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
