# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Main database (your development data)
DATABASE_URL=postgresql+psycopg2://mmm_user:$omepassword@localhost:5432/mmm

# Separate database used ONLY by pytest. The name must end with "_test".
TEST_DATABASE_URL=postgresql+psycopg2://mmm_user:$omepassword@localhost:5432/mmm_test

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. The app will not start without it.
JWT_SECRET=secretsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss

JWT_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# Password given to the three demo users created by seed.py (8-64 chars, letter + digit)
SEED_DEMO_PASSWORD=Demo12345
